# ---- Rakib ----
APP_NAME=Rakib
ENVIRONMENT=development
LOG_LEVEL=INFO

MONGO_URI=mongodb://mongo:27017/reclamations
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
# signe les liens de suivi publics — jamais un identifiant de session
TRACKING_TOKEN_SECRET=change-me-too
TRACKING_TOKEN_TTL_DAYS=365

# Relais sortant uniquement. Les identifiants ne sont jamais versionnes :
# le script de deploiement les lit depuis un secret du cluster.
# SMTP_HOST vide = aucun courriel envoye, le reste du systeme fonctionne.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

FRONTEND_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5173
