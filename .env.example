# ---- Rakib ----
APP_NAME=Rakib
ENVIRONMENT=development
LOG_LEVEL=INFO

MONGO_URI=mongodb://mongo:27017/reclamations
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
# signs public complaint-tracking + satisfaction links (never a session credential)
TRACKING_TOKEN_SECRET=change-me-too
TRACKING_TOKEN_TTL_DAYS=365

TRIAGE_BACKEND=ml
ML_ARTIFACTS_DIR=./ml_artifacts
CATEGORY_CONFIDENCE_THRESHOLD=0.55
AMBIGUITY_MARGIN=0.15
DEDUP_AUTO_THRESHOLD=0.82
DEDUP_SUGGEST_THRESHOLD=0.65
DEDUP_CROSS_CLAIMANT_THRESHOLD=0.90
RETRAIN_MIN_SAMPLES=200
RETRAIN_CORRECTION_TRIGGER=50
RETRAIN_F1_TOLERANCE=0.02

SLA_BUSINESS_HOURS=false
SLA_TIMEZONE=Africa/Tunis
SLA_HOURS_P1=4
SLA_HOURS_P2=24
SLA_HOURS_P3=72
SLA_HOURS_P4=168

S3_ENDPOINT=http://minio:9000
S3_BUCKET=reclamations
S3_ACCESS_KEY=rakib
S3_SECRET_KEY=rakib-dev-secret
S3_REGION=us-east-1

# outbound only — Hostinger relay, mirrors the elitetek-academy setup
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

FRONTEND_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5173

# OPTIONAL — only for TRIAGE_BACKEND=llm. Absent in every normal deployment.
OPENROUTER_API_KEY=
